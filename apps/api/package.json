{
  "name": "@booking-scheduler/api",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/typeorm": "latest",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "latest",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "typeorm": "latest"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "latest",
    "@nestjs/testing": "^11.1.21",
    "@swc/core": "^1.15.33",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.0",
    "ts-node": "latest",
    "typescript": "latest",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.7"
  }
}
